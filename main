    <title>StreamFinder - Netflix Style</title>
    <!-- Load Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Custom Font Setup & Base Styling */
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0d0d0d; /* Very dark background */
        }
        .text-red-gemini {
            color: #E50914; /* Netflix Red */
        }
        .bg-red-gemini {
            background-color: #E50914;
        }
        /* Custom Scrollbar for a sleek look */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-thumb {
            background: #444;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #555;
        }
        .result-card {
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .result-card:hover {
            transform: scale(1.05);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.5);
            z-index: 10;
        }
        .episode-modal-input {
            appearance: textfield; /* Fix for Firefox */
        }
        .episode-modal-input::-webkit-outer-spin-button,
        .episode-modal-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        /* Hide scrollbar for the favorites container */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none; /* IE and Edge */
            scrollbar-width: none;  /* Firefox */
        }
    </style>
</head>
<body class="min-h-screen text-white">

    <!-- Note: Firebase imports have been removed. Data persistence is now handled by browser Local Storage. -->
    
    <!-- Header & Navigation -->
    <header class="sticky top-0 z-50 bg-gray-900 shadow-lg border-b border-gray-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col md:flex-row justify-between items-center">
            <h1 class="text-3xl font-bold text-red-gemini mb-4 md:mb-0">
                STREAM<span class="text-white">FINDER</span>
            </h1>

            <!-- Search Bar -->
            <div class="w-full md:w-auto flex space-x-2">
                <input type="text" id="searchInput" placeholder="Search for a movie or TV show..."
                       class="w-full md:w-80 p-3 rounded-lg bg-gray-800 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-red-gemini transition duration-200"
                       onkeydown="if(event.key === 'Enter') document.getElementById('searchButton').click()">
                <button id="searchButton"
                        class="bg-red-gemini hover:bg-red-700 text-white font-semibold py-3 px-6 rounded-lg shadow-lg transition duration-200 whitespace-nowrap">
                    Search
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        <!-- Favorites Section -->
        <section class="mb-12">
            <h2 class="text-2xl font-bold text-white mb-4">Your Favorites</h2>
            <div id="favoritesContainer" class="flex overflow-x-scroll space-x-4 no-scrollbar pb-4">
                <p id="favoritesStatus" class="text-gray-400">Loading favorites...</p>
                <!-- Favorite cards will be rendered here -->
            </div>
        </section>
        
        <h2 class="text-2xl font-bold text-white mb-4">Search Results</h2>
        
        <!-- Status/Error Message Area -->
        <div id="statusMessage" class="text-center p-4 text-lg font-semibold text-gray-400">
            Start searching for your favorite titles!
        </div>

        <!-- Results Grid -->
        <section id="resultsContainer" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6 pt-4">
            <!-- Movie/TV Show cards will be injected here -->
        </section>
    </main>

    <!-- Episode Selection Modal (Hidden by default) -->
    <div id="episodeModal" class="hidden fixed inset-0 bg-black bg-opacity-75 z-[70] flex items-center justify-center p-4">
        <div class="bg-gray-800 p-8 rounded-xl shadow-2xl w-full max-w-sm border-t-4 border-red-gemini">
            <h3 class="text-2xl font-bold mb-4 text-white" id="modalTitle">Select Episode</h3>
            <p class="text-gray-300 mb-6">Enter the season and episode number to start watching this series.</p>
            
            <div class="flex space-x-4 mb-6">
                <div class="flex-1">
                    <label for="seasonInput" class="block text-sm font-medium text-gray-400 mb-1">Season (S)</label>
                    <input type="number" id="seasonInput" value="1" min="1"
                           class="episode-modal-input w-full p-3 rounded-lg bg-gray-700 border border-gray-600 focus:ring-red-gemini focus:border-red-gemini text-white">
                </div>
                <div class="flex-1">
                    <label for="episodeInput" class="block text-sm font-medium text-gray-400 mb-1">Episode (E)</label>
                    <input type="number" id="episodeInput" value="1" min="1"
                           class="episode-modal-input w-full p-3 rounded-lg bg-gray-700 border border-gray-600 focus:ring-red-gemini focus:border-red-gemini text-white">
                </div>
            </div>

            <div class="flex justify-end space-x-3">
                <button onclick="closeModal()" class="px-4 py-2 text-gray-300 rounded-lg hover:bg-gray-700 transition duration-150">
                    Cancel
                </button>
                <button id="watchEpisodeButton" class="bg-red-gemini hover:bg-red-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-150">
                    Watch Now
                </button>
            </div>
        </div>
    </div>

    <!-- PLAYER MODAL -->
    <div id="playerModal" class="hidden fixed inset-0 bg-black bg-opacity-90 z-[80] flex flex-col items-center justify-center p-4">
        <div class="w-full h-full max-w-5xl max-h-[80vh] relative">
            <!-- Control Buttons (Fullscreen and Close) -->
            <div class="absolute -top-10 right-0 md:-top-12 md:right-0 z-50 flex space-x-2">
                <!-- Fullscreen Button -->
                <button onclick="toggleFullScreen()" id="fullscreenButton" title="Toggle Fullscreen" class="text-white bg-gray-800 hover:bg-red-gemini p-2 rounded-full transition duration-200">
                    <svg id="fullscreenIcon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <!-- Expand Icon -->
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
                    </svg>
                </button>
                <!-- Close Button -->
                <button onclick="closePlayerModal()" title="Close Player" class="text-white bg-gray-800 hover:bg-red-gemini p-2 rounded-full transition duration-200">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <!-- Title -->
            <h3 id="playerTitle" class="text-xl font-bold mb-2 text-white truncate w-full"></h3>
            <!-- Iframe Container - Uses aspect-video for responsive 16:9 ratio -->
            <div class="aspect-video w-full bg-black rounded-lg overflow-hidden shadow-2xl border-2 border-gray-700">
                <iframe id="playerIframe" src="" frameborder="0" allowfullscreen allow="autoplay; encrypted-media" class="w-full h-full"></iframe>
            </div>
        </div>
    </div>
    <!-- END PLAYER MODAL -->

    <!-- Message Box (For alerts/errors) -->
    <div id="messageBox" class="hidden fixed bottom-5 right-5 z-50 bg-gray-800 text-white p-4 rounded-lg shadow-xl border-l-4 border-red-gemini transition-opacity duration-300">
        <p id="messageContent" class="font-medium"></p>
    </div>

    <script>
        // --- API Configuration ---
        const API_KEY = "89183001";
        const OMDB_BASE_URL = "https://www.omdbapi.com/?apikey=" + API_KEY + "&s=";
        const LOCAL_STORAGE_KEY = "streamFinderFavorites";

        // --- DOM Elements ---
        const searchInput = document.getElementById('searchInput');
        const searchButton = document.getElementById('searchButton');
        const resultsContainer = document.getElementById('resultsContainer');
        const statusMessage = document.getElementById('statusMessage');
        const messageBox = document.getElementById('messageBox');
        const messageContent = document.getElementById('messageContent');
        const episodeModal = document.getElementById('episodeModal');
        const watchEpisodeButton = document.getElementById('watchEpisodeButton');
        const favoritesContainer = document.getElementById('favoritesContainer');
        const favoritesStatus = document.getElementById('favoritesStatus');
        
        const playerModal = document.getElementById('playerModal');
        const playerIframe = document.getElementById('playerIframe');
        const playerTitle = document.getElementById('playerTitle');

        let currentSeriesImdbId = null; 
        
        // Global state for fast lookup of favorited items (IMDb ID)
        const userFavorites = new Set();


        // --- Local Storage Initialization ---
        window.onload = function() {
            loadFavoritesFromLocalStorage();
        };

        /**
         * Loads the favorites array from Local Storage, populates the set, and renders the UI.
         */
        function loadFavoritesFromLocalStorage() {
            userFavorites.clear();
            favoritesStatus.textContent = "Loading favorites...";

            try {
                const storedJson = localStorage.getItem(LOCAL_STORAGE_KEY);
                const storedFavorites = storedJson ? JSON.parse(storedJson) : [];
                
                // Populate the Set for quick lookups
                storedFavorites.forEach(item => {
                    userFavorites.add(item.imdbID);
                });
                
                // Render the list
                renderFavorites(storedFavorites);
            } catch (error) {
                console.error("Error loading favorites from local storage:", error);
                favoritesStatus.textContent = "Error loading local favorites data. Clear browser cache if issue persists.";
                renderFavorites([]);
            }
        }

        // --- Favorites Rendering & Logic ---

        /**
         * Renders the favorite items in the dedicated section.
         * @param {Array<Object>} favorites - Array of favorite media objects.
         */
        function renderFavorites(favorites) {
            favoritesContainer.innerHTML = '';
            
            if (favorites.length === 0) {
                favoritesStatus.textContent = "No favorites added yet. Search and click the heart icon to save titles!";
                favoritesContainer.appendChild(favoritesStatus);
                return;
            }
            
            // Remove the status message if there are favorites
            favoritesStatus.remove();

            // Create cards for each favorite item
            favorites.forEach(item => {
                const card = createMediaCard(item, true); // true for isFavoriteCard
                favoritesContainer.appendChild(card);
            });
        }

        /**
         * Toggles the favorite status of a media item in Local Storage.
         * @param {Object} item - The media item object ({Title, Year, Type, Poster, imdbID}).
         */
        function handleFavoriteToggle(item) {
            const { imdbID, Title } = item;

            try {
                const storedJson = localStorage.getItem(LOCAL_STORAGE_KEY);
                let favoritesArray = storedJson ? JSON.parse(storedJson) : [];

                if (userFavorites.has(imdbID)) {
                    // REMOVE from favorites
                    favoritesArray = favoritesArray.filter(fav => fav.imdbID !== imdbID);
                    showMessage(`Removed "${Title}" from favorites!`, 'info');
                } else {
                    // ADD to favorites
                    favoritesArray.push({
                        Title: item.Title,
                        Year: item.Year,
                        Type: item.Type,
                        Poster: item.Poster,
                        imdbID: item.imdbID,
                        addedAt: new Date().toISOString()
                    });
                    showMessage(`Added "${Title}" to favorites!`, 'info');
                }

                // Save the updated array back to local storage
                localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(favoritesArray));
                
                // Manually trigger UI update to reflect the change
                loadFavoritesFromLocalStorage();

            } catch (error) {
                console.error("Error toggling favorite status in local storage:", error);
                showMessage(`Failed to update favorites for "${Title}".`, 'error');
            }
        }


        // --- UI Component Creation ---

        /**
         * Creates a single media card element.
         * @param {Object} item - The media item data.
         * @param {boolean} [isFavoriteCard=false] - Whether this card is being rendered in the Favorites section.
         * @returns {HTMLElement} The card element.
         */
        function createMediaCard(item, isFavoriteCard = false) {
            const isFavorite = userFavorites.has(item.imdbID);
            const card = document.createElement('div');
            
            // Use different styling if it's a favorite card (to make them slightly smaller for the carousel)
            const baseClasses = isFavoriteCard 
                ? 'w-40 flex-shrink-0 cursor-pointer rounded-lg overflow-hidden bg-gray-800 hover:bg-gray-700 transition duration-300 relative'
                : 'result-card cursor-pointer rounded-lg overflow-hidden bg-gray-800 hover:bg-gray-700 transition duration-300 relative';
            
            card.className = baseClasses;
            card.setAttribute('data-imdbid', item.imdbID);
            card.setAttribute('data-type', item.Type);
            card.setAttribute('data-title', item.Title);

            // Heart icon logic: filled if favorited, outline if not.
            const heartIcon = isFavorite 
                ? `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 fill-red-gemini stroke-red-gemini" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="0" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>`
                : `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>`;

            // Create a JSON string representation of the item for the inline function call
            const itemJson = JSON.stringify({
                Title: item.Title,
                Year: item.Year,
                Type: item.Type,
                Poster: item.Poster,
                imdbID: item.imdbID
            }).replace(/"/g, '&quot;'); // Escape quotes for HTML attribute

            card.innerHTML = `
                <img src="${item.Poster}" alt="${item.Title} Poster" 
                     class="w-full h-auto object-cover" 
                     onerror="this.onerror=null;this.src='https://placehold.co/300x450/1f2937/fff?text=No+Poster'">
                
                <!-- Favorite Toggle Button -->
                <button class="absolute top-2 right-2 p-1 bg-black bg-opacity-70 rounded-full hover:bg-red-gemini transition duration-200" 
                        title="${isFavorite ? 'Remove from Favorites' : 'Add to Favorites'}" 
                        onclick="event.stopPropagation(); window.handleFavoriteToggle(JSON.parse('${itemJson}'));">
                    ${heartIcon}
                </button>
                
                <div class="p-3">
                    <h2 class="text-base font-semibold truncate text-white">${item.Title}</h2>
                    <p class="text-xs text-gray-400">${item.Year} | ${item.Type === 'movie' ? 'Movie' : 'Series'}</p>
                </div>
            `;

            // Attach event listener for video playback (on card click, not button click)
            card.addEventListener('click', () => handleCardClick(item.Title, item.imdbID, item.Type));
            return card;
        }

        // --- Core Search Functionality (Unchanged) ---

        /**
         * Fetches media from OMDb API based on the search query.
         * @param {string} query - The search term.
         */
        async function searchMedia(query) {
            if (query.trim() === '') {
                showMessage('Please enter a search term.', 'error');
                return;
            }

            setStatus(query, true);
            const encodedQuery = encodeURIComponent(query.trim());
            const url = OMDB_BASE_URL + encodedQuery;

            const MAX_RETRIES = 3;
            for (let attempt = 0; attempt < MAX_RETRIES; attempt++) {
                try {
                    const response = await fetch(url);
                    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                    
                    const data = await response.json();
                    
                    if (data.Response === "True") {
                        displayResults(data.Search);
                        return;
                    } else {
                        setStatus(`No results found for "${query}". Try a different search term.`);
                        return;
                    }
                } catch (error) {
                    console.error(`Attempt ${attempt + 1} failed:`, error);
                    if (attempt === MAX_RETRIES - 1) {
                        setStatus(`Failed to fetch results after ${MAX_RETRIES} attempts. Network or API error. (Check console for details)`);
                        showMessage('Search failed due to a network or API issue.', 'error');
                        return;
                    }
                    const delay = Math.pow(2, attempt) * 1000;
                    await new Promise(resolve => setTimeout(resolve, delay));
                }
            }
        }

        /**
         * Renders the search results into the container.
         * @param {Array<Object>} results - Array of media objects from OMDb.
         */
        function displayResults(results) {
            statusMessage.style.display = 'none';
            resultsContainer.innerHTML = '';
            
            results.filter(item => item.Poster !== 'N/A').forEach(item => {
                const card = createMediaCard(item);
                resultsContainer.appendChild(card);
            });
        }

        /**
         * Handles the click on a movie or series card.
         */
        function handleCardClick(title, imdbID, type) {
            if (type === 'movie') {
                const url = `https://vidsrc-embed.ru/embed/movie/${imdbID}`;
                openPlayer(url, title);
            } else if (type === 'series') {
                showModal(title, imdbID);
            } else {
                showMessage(`Unsupported media type: ${type}.`, 'error');
            }
        }


        // --- Player and Modal Functions (Unchanged) ---

        function showMessage(message, type = 'info') {
            const color = type === 'error' ? 'border-red-500' : 'border-blue-500';
            messageContent.textContent = message;
            messageBox.className = `fixed bottom-5 right-5 z-50 bg-gray-800 text-white p-4 rounded-lg shadow-xl border-l-4 ${color} transition-opacity duration-300`;
            messageBox.classList.remove('hidden');
            
            setTimeout(() => {
                messageBox.classList.add('hidden');
            }, 3000);
        }

        function setStatus(message, isLoading = false) {
            resultsContainer.innerHTML = '';
            statusMessage.textContent = message;
            statusMessage.style.display = 'block';
            if (isLoading) {
                statusMessage.innerHTML = `<svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-red-gemini inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Searching...`;
            }
        }

        function showModal(title, imdbID) {
            currentSeriesImdbId = imdbID;
            document.getElementById('modalTitle').textContent = `Watch ${title}`;
            document.getElementById('seasonInput').value = 1;
            document.getElementById('episodeInput').value = 1;
            episodeModal.classList.remove('hidden');
        }

        function closeModal() {
            episodeModal.classList.add('hidden');
            currentSeriesImdbId = null;
        }

        function openPlayer(url, title) {
            playerTitle.textContent = title;
            playerIframe.src = url;
            playerModal.classList.remove('hidden');
            showMessage(`Starting playback for: ${title}`, 'info');
        }

        function closePlayerModal() {
            playerIframe.src = "";
            playerModal.classList.add('hidden');
        }
        
        function toggleFullScreen() {
            const element = playerIframe;
            if (!document.fullscreenElement) {
                if (element.requestFullscreen) {
                    element.requestFullscreen();
                } else if (element.webkitRequestFullscreen) {
                    element.webkitRequestFullscreen();
                } else if (element.msRequestFullscreen) {
                    element.msRequestFullscreen();
                }
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                } else if (document.webkitExitFullscreen) {
                    document.webkitExitFullscreen();
                } else if (document.msExitFullscreen) {
                    document.msExitFullscreen();
                }
            }
        }

        // --- Event Listeners ---
        searchButton.addEventListener('click', () => {
            searchMedia(searchInput.value);
        });

        watchEpisodeButton.addEventListener('click', () => {
            const season = document.getElementById('seasonInput').value;
            const episode = document.getElementById('episodeInput').value;
            const baseTitle = document.getElementById('modalTitle').textContent.replace('Watch ', ''); 
            
            if (!currentSeriesImdbId || !season || !episode || season < 1 || episode < 1) {
                showMessage('Please enter valid Season and Episode numbers.', 'error');
                return;
            }

            const url = `https://vidsrc-embed.ru/embed/tv?imdb=${currentSeriesImdbId}&season=${season}&episode=${episode}`;
            closeModal();
            openPlayer(url, `${baseTitle} - S${season} E${episode}`);
        });
        
        episodeModal.addEventListener('click', (e) => {
            if (e.target.id === 'episodeModal') {
                closeModal();
            }
        });
        
        // Expose the handler globally for inline onclick attribute in dynamic HTML
        window.handleFavoriteToggle = handleFavoriteToggle;

    </script>
</body>
</html>
